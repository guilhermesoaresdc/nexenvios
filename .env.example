# ─────────────────────────────────────────────────────────── obrigatórias

# Postgres do Supabase. Use a string do POOLER em modo transação (porta 6543):
# Supabase → Project Settings → Database → Connection string → Transaction pooler.
# Serverless abre uma conexão por invocação; o pooler é o que evita estourar o
# limite do projeto. A senha vai codificada na URL (# vira %23, $ vira %24).
DATABASE_URL=postgresql://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres

# Migrations e seed. Pode ser a mesma coisa; existe separada para o dia em que
# a aplicação rodar com um papel de menos privilégio que o dono das tabelas.
DATABASE_URL_ADMIN=

# 32 bytes em hex. Cifra as credenciais de provedor em repouso (AES-256-GCM).
# Gere com: openssl rand -hex 32
# PERDER ESTA CHAVE TORNA AS CREDENCIAIS SALVAS ILEGÍVEIS — não há recuperação,
# é preciso reconfigurar todos os canais.
ENCRYPTION_KEY=

# Protege GET /api/cron. SEM ESTA VARIÁVEL A ROTA RECUSA TUDO, de propósito:
# uma rota que dispara em nome de todos os clientes não pode ficar aberta por
# esquecimento de configuração.
# Gere com: openssl rand -base64url 32
CRON_SECRET=

# ────────────────────────────────────────────────────────────── opcionais

# Endereço público. Entra nos links de convite e recuperação de senha.
APP_URL=https://nexenvios.com.br

# E-mail transacional (convite e recuperação). Sem a chave, o link é escrito no
# log do servidor e a operação segue — o administrador copia e manda pelo canal
# que quiser. Numa instalação nova, sem domínio verificado, travar o convite por
# causa do e-mail seria pior.
RESEND_API_KEY=
EMAIL_REMETENTE=Nex Envios <nao-responda@nexenvios.com.br>

# O número que a landing usa no rodapé e no fim do formulário. DDI+DDD+número,
# só dígitos.
NEXT_PUBLIC_WHATSAPP=5588992640298

# O formulário de proposta da landing é um fluxo publicado no CRM Hédiz, servido
# num iframe. Origem precisa bater exatamente com o `origin` do CRM: é ela que
# valida o postMessage que redimensiona o iframe.
NEXT_PUBLIC_FLUXO_ORIGEM=https://crm.hediz.com
NEXT_PUBLIC_FLUXO_SLUG=nex-envios-site-7q4zd

# Primeiro superadmin criado por `npm run db:seed`. Sem ADMIN_SENHA, uma senha
# aleatória é gerada e impressa UMA ÚNICA VEZ.
ADMIN_EMAIL=admin@nexenvios.com.br
ADMIN_SENHA=

# Quantas linhas o motor tenta enviar por batida. Ajuste ao teto de tempo da
# função: 60s no plano Hobby da Vercel.
LOTE_DO_MOTOR=60

# debug | info | warn | error
LOG_LEVEL=info
